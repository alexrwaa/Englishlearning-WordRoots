{
  "name": "wordroots",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "WordRoots - interactive English morphology & etymology learning system",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "tauri": "tauri",
    "check:stubs": "tsx scripts/check-stubs.ts",
    "coverage": "tsx scripts/coverage.ts",
    "coverage:write": "tsx scripts/coverage.ts --write && tsx scripts/coverage.ts --json",
    "lexicon:stats": "tsx scripts/lexicon-tool.ts stats",
    "lexicon:check": "tsx scripts/lexicon-tool.ts check",
    "lexicon:merge": "tsx scripts/lexicon-tool.ts merge",
    "textbook:build": "tsx scripts/build-elements.ts --morphemes && tsx scripts/build-textbook.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@tauri-apps/cli": "2.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "playwright-core": "^1.49.1",
    "ts-fsrs": "4.5.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
