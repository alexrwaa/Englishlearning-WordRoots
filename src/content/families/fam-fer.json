        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "prefer",
      "relation": "derivative",
      "glossZh": "更喜欢",
      "layer": [
        "pre-",
        "fer"
      ],
      "note": "pre- 在前 + 带 → 把某物放到前面",
