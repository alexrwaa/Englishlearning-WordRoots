{
  "id": "fam-fer",
  "root": {
    "form": "fer",
    "glossEn": "carry, bring",
    "glossZh": "携带、带来",
    "origin": "Lat",
    "etymon": "ferre",
    "etymonGloss": "to bear, carry, bring"
  },
  "coreIdea": "「带」的方向决定词义：带到前面是偏爱，带到下面承受是受苦。",
  "members": [
    {
      "w": "transfer",
      "relation": "derivative",
      "glossZh": "转移",
      "layer": [
        "trans-",
        "fer"
      ],
      "note": "trans- 越过 + 带 → 从一方带到另一方",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "refer",
      "relation": "derivative",
      "glossZh": "提及；查阅",
      "layer": [
        "re-",
        "fer"
      ],
      "note": "re- 回 + 带 → 把话题带回某处",
