        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "offer",
      "relation": "derivative",
      "glossZh": "提供",
      "layer": [
        "of-",
        "fer"
      ],
      "note": "of- 是 ob- 的同化变体，向着 + 带 → 带到对方面前",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1",
        "note": "of- 是 ob- 在 f 前的同化形式"
      }
    },
    {
      "w": "confer",
      "relation": "derivative",
      "glossZh": "商议；授予",
      "layer": [
        "con-",
        "fer"
      ],
      "note": "con- 一起 + 带 → 把意见带到一处",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "infer",
      "relation": "derivative",
      "glossZh": "推断",
      "layer": [
        "in-",
        "fer"
      ],
      "note": "in- 向内 + 带 → 把结论带进已知里",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "differ",
      "relation": "derivative",
      "glossZh": "不同",
      "layer": [
        "dif-",
        "fer"
      ],
      "note": "dif- 是 dis- 的变体，分开 + 带 → 各带各的方向",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1",
        "note": "dif- 是 dis- 在 f 前的同化形式"
      }
    },
    {
      "w": "suffer",
      "relation": "derivative",
      "glossZh": "受苦",
      "layer": [
        "suf-",
        "fer"
      ],
      "note": "suf- 是 sub- 的变体，在下面 + 扛",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1",
        "note": "suf- 是 sub- 在 f 前的同化形式"
      }
    },
    {
