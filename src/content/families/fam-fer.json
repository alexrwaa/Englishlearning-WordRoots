      "glossZh": "大声疾呼的",
      "layer": [
        "voci-",
        "fer",
        "-ous"
      ],
      "note": "voci- 声音（vox）+ fer 带 + -ous → 把声音带出来的",
      "analysis": {
        "kind": "analogical",
        "verified": false,
        "source": "S5",
        "note": "voci- 是 vox 的连接形式，不是前缀"
      }
    },
    {
      "w": "proliferate",
      "relation": "derivative",
      "glossZh": "激增",
      "layer": [
        "proli-",
        "fer",
        "-ate"
      ],
      "note": "proli- 后代（proles）+ fer 带 → 不断带出后代",
