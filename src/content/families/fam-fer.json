        "note": "proli- 来自 proles，不是现代词素"
      }
    },
    {
      "w": "translate",
      "relation": "derivative",
      "glossZh": "翻译",
      "layer": [
        "trans-",
        "lat"
      ],
      "note": "lat 是 ferre 的分词词干 latus（异根替换）：trans- 越过 + 带过去",
      "analysis": {
        "kind": "historical",
        "verified": false,
        "source": "S5",
        "note": "lat- 是 fer 的异干（拉丁 latus）；现代 translate 里没有 fer"
      }
    },
    {
      "w": "referendum",
      "relation": "derivative",
      "glossZh": "公投",
      "layer": [
        "re-",
        "fer"
      ],
      "note": "re- 回 + 带：交给选民「带回决定」的事；-endum 是拉丁将来被动分词，未单列",
      "analysis": {
        "kind": "historical",
        "verified": false,
        "source": "S5",
        "note": "拉丁动形词整体借入；re + fer 拼不出 referendum"
      }
    }
  ],
  "allomorphs": [
    {
      "form": "fert",
      "note": "拉丁分词词干，出现在「带来收成」这一支",
      "examples": [
        "fertile",
        "fertility",
        "fertilizer"
      ]
    },
    {
      "form": "lat",
      "note": "异根替换（suppletion）：ferre 的过去分词是 latus，不是 *fertus",
      "examples": [
        "translate",
        "relate",
        "collate"
      ]
    }
  ],
  "derivationChains": [
    {
      "stages": [
        "fer",
        "refer",
        "reference",
        "referential"
      ],
      "note": "每一级都真实成词；-ence 与 -ential 是两条并行后缀"
    },
    {
      "stages": [
        "fer",
        "prefer",
        "preference",
        "preferential"
      ],
      "note": "preference 去 e 加 -ial 时拼作 -ential"
    },
    {
      "stages": [
        "fer",
        "transfer",
        "transference",
        "transferable"
      ],
      "note": "transference 偏心理学「移情」，transferable 偏「可转让」"
    },
    {
      "stages": [
        "fer",
        "fertile",
        "fertility",
        "fertilization"
      ],
      "note": "fertile 的 -ile 换 -ity 时要插 -il-"
    }
  ],
  "semanticShifts": [
    {
      "w": "prefer",
      "from": "带到前面",
      "to": "更喜欢",
      "why": "把某个选项放到其他选项之前"
    },
    {
      "w": "offer",
      "from": "带到面前",
      "to": "提供、奉献",
      "why": "把东西带到对方面前，就是给出"
    },
    {
      "w": "suffer",
      "from": "在下面扛着",
      "to": "受苦",
      "why": "重压之下仍要承担"
    },
    {
      "w": "differ",
      "from": "分开带",
      "to": "不同",
      "why": "各自被带往不同方向 → 有差别"
    }
  ],
  "homographTraps": [
    {
      "form": "fer",
      "other": "ferrous、ferric、ferrite 里的 fer 来自拉丁 ferrum「铁」",
      "note": "同形异源：ferrous 与「携带」无关；冶金语境一律按「铁」读"
    },
    {
      "form": "conifer",
      "other": "coni- 是 conus「圆锥」，不是 con-「共同」",
      "note": "拆成 con + i + fer 会得到错误释义；应是「带球果的」"
    }
  ],
  "teaching": {
    "induction": "给出 transfer、refer、prefer、offer、suffer 五个词，问：共同的「带」在哪个词里最直观？前缀把「带」的方向改成了什么？",
    "transfer": {
      "word": "vociferous",
      "question": "拆开并猜义：voci- + fer + -ous 三部分各是什么？",
      "answer": "voci- 声音（vox）+ fer 带 + -ous 多…的 → 把声音大声带出来的，即「大声疾呼的」。例句：The proposal drew vociferous objections from residents."
    }
  },
