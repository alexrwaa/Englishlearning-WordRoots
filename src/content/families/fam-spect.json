{
  "id": "fam-spect",
  "root": {
    "form": "spect",
    "glossEn": "look at",
    "glossZh": "看",
    "origin": "Lat",
    "etymon": "specere",
    "etymonGloss": "to look at, observe"
  },
  "coreIdea": "一切从「看」出发：往哪个方向看，决定词义往哪里走。",
  "members": [
    {
      "w": "inspect",
      "relation": "derivative",
      "glossZh": "检查",
      "layer": [
        "in-",
        "spect"
      ],
      "note": "in- 向内 + spect 看 → 往里看，逐处查看",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "expect",
      "relation": "derivative",
      "glossZh": "期待",
      "layer": [
        "ex-",
        "pect"
      ],
      "note": "ex- 向外 + spect；x 后 s 脱落写作 pect → 向外张望、等候",
      "analysis": {
        "kind": "analogical",
        "verified": false,
        "source": "S1",
        "note": "ex + pect：pect 是 spect 在 ex- 后掉 s 的异形，属于教学拆分，不是现代能产规则"
      }
    },
    {
      "w": "respect",
      "relation": "derivative",
      "glossZh": "尊敬",
      "layer": [
        "re-",
        "spect"
      ],
      "note": "re- 回 + 看 → 回头看，引申为看重",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "suspect",
      "relation": "derivative",
      "glossZh": "怀疑",
      "layer": [
        "sus-",
        "spect"
      ],
      "note": "sus- 是 sub- 的变体，从下往上看 → 暗中打量",
      "analysis": {
        "kind": "analogical",
        "verified": false,
        "source": "S1",
        "note": "sus + spect 拼出 susspect；实际写作 sus + pect（s 脱落）"
      }
    },
    {
      "w": "prospect",
      "relation": "derivative",
      "glossZh": "前景",
      "layer": [
        "pro-",
        "spect"
      ],
      "note": "pro- 向前 + 看 → 向前望到的景象",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "retrospect",
      "relation": "derivative",
      "glossZh": "回顾",
      "layer": [
        "retro-",
        "spect"
      ],
      "note": "retro- 向后 + 看",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "spectator",
      "relation": "derivative",
      "glossZh": "观众",
      "layer": [
        "spectate",
        "-or"
      ],
      "note": "现代共时切分：spectate + -or。spectate 是由 spectator 逆构出来的动词；拉丁历史形态是 spect + -ator，方向不能反过来讲。",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S5",
        "note": "现代共时是 spectate + -or；spectate 是由 spectator 逆构出来的动词",
        "alternatives": [
          {
            "layer": [
              "spect",
              "-ator"
            ],
            "kind": "historical",
            "verified": false,
            "source": "S5",
            "note": "拉丁历史形态 spect + -ator；不能反过来讲成 spectate 由它派生"
          }
        ]
      }
    },
    {
      "w": "perspective",
      "relation": "derivative",
      "glossZh": "视角",
      "layer": [
        "per-",
        "spect",
        "-ive"
      ],
      "note": "per- 穿过 + 看 → 透过某处看到的景象",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "specify",
      "relation": "derivative",
      "glossZh": "明确说明",
      "layer": [
        "spec",
        "-ify"
      ],
      "note": "源自 species「外观、种类」（< specere）+ -ify → 把类别说定",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "specific",
      "relation": "derivative",
      "glossZh": "具体的",
      "layer": [
        "spec",
        "-ific"
      ],
      "note": "-ific 使…的：被指明到某一类的",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "spectacle",
      "relation": "derivative",
      "glossZh": "景象；眼镜",
      "layer": [
        "spect",
        "-acle"
      ],
      "note": "-acle 表对象或工具 → 供观看之物；spectacles 是「用来看的东西」",
      "analysis": {
        "kind": "analogical",
        "verified": false,
        "source": "S1",
        "note": "-acle 不具能产性；spect + -acle 是教学拆分"
      }
    },
    {
      "w": "introspect",
      "relation": "derivative",
      "glossZh": "内省",
      "layer": [
        "intro-",
        "spect"
      ],
      "note": "intro- 向内 + 看",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "circumspect",
      "relation": "derivative",
      "glossZh": "谨慎的",
      "layer": [
        "circum-",
        "spect"
      ],
      "note": "circum- 环绕 + 看 → 四面都看到，不冒进",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "despise",
      "relation": "derivative",
      "glossZh": "鄙视",
      "layer": [
        "de-",
        "spic"
      ],
      "note": "de- 向下 + spic 看 → 从上往下看",
      "analysis": {
        "kind": "historical",
        "verified": false,
        "source": "S5",
        "note": "de + spic 拼不出 despise；spic 是拉丁 specere 的内部形式"
      }
    },
    {
      "w": "auspices",
      "relation": "cognate",
      "glossZh": "预兆；赞助",
      "note": "auspex = avis 鸟 + specere 看：观鸟占卜，走的是名词复合这条路，不按 spect 切分",
      "analysis": {
        "kind": "cognate",
        "verified": false
      }
    },
    {
      "w": "spectrum",
      "relation": "cognate",
      "glossZh": "光谱；范围",
      "note": "spectrum 原义「影像、幻象」，同出 specere；19 世纪才被借为物理术语",
      "analysis": {
        "kind": "cognate",
        "verified": false
      }
    }
  ],
  "allomorphs": [
    {
      "form": "spec",
      "note": "词根元音弱化，多出现在 -ify / -ific / -ial 前",
      "examples": [
        "specify",
        "specific",
        "special"
      ]
    },
    {
      "form": "spic",
      "note": "拉丁内部形式，保留在复合词里",
      "examples": [
        "conspicuous",
        "despise",
        "perspicacious"
      ]
    },
    {
      "form": "pect",
      "note": "ex- 后 s 脱落，-spect- 写作 -pect-",
      "examples": [
        "expect",
        "expectant",
        "unexpected"
      ]
    }
  ],
  "derivationChains": [
    {
      "stages": [
        "spect",
        "inspect",
        "inspection",
        "inspector"
      ],
      "note": "每一级都真实成词；-ion 造动作名词，-or 再造施动者"
    },
    {
      "stages": [
        "spect",
        "respect",
        "respectable",
        "respectability"
      ],
      "note": "-able 造形容词，-ity 再加一层名词"
    },
    {
      "stages": [
        "spect",
        "prospect",
        "prospective",
        "prospector"
      ],
      "note": "prospective 与 prospector 是 prospect 的两条不同派生路，不是先后关系"
    }
  ],
  "semanticShifts": [
    {
      "w": "respect",
      "from": "回头看",
      "to": "尊敬、重视",
      "why": "反复看一个人 → 把他放在心上 → 看重"
    },
    {
      "w": "expect",
      "from": "向外张望",
      "to": "期待",
      "why": "张望的正是等着要来的东西"
    },
    {
      "w": "spectacle",
      "from": "供观看之物",
      "to": "壮观场面；眼镜",
      "why": "同一动作的两个方向：被看的对象，和用来看的工具"
    },
    {
      "w": "prospect",
      "from": "向前看",
      "to": "前景、可能性",
      "why": "向前看到的景象 → 未来可能出现的事"
    }
  ],
  "homographTraps": [
    {
      "form": "pect",
      "other": "pectoral（胸的）、pectus 里的 pect 来自拉丁 pectus「胸」",
      "note": "expect 的 pect 只是 spect 掉了 s，别拆成 ex +「胸」"
    },
    {
      "form": "spectr",
      "other": "spectrum / spectral 虽同出 specere，但已固定表示「影像、光谱」",
      "note": "同源不同义项：不能用 spectral 反推 spect = 光"
    }
  ],
  "teaching": {
    "induction": "先给 inspect、respect、prospect、retrospect、spectator 五个词，问：它们共同的动作是什么？每个前缀把「看」指向了哪个方向？",
    "transfer": {
      "word": "perspicacious",
      "question": "拆开并猜义：per- + spic + -acious 各自贡献了什么？",
      "answer": "per- 透过 + spic 看 + -acious 多…的 → 能看穿表面的，即「洞察力强的」。例句：Her perspicacious reading of the data anticipated the market shift by a year."
    }
  },
  "sources": [
    {
      "id": "S1",
      "detail": "ch.9 Latin/Greek element list（spec-/spect-/spic- 条）；ch.4 同化与 s 脱落例"
    },
    {
      "id": "S5",
      "detail": "Oxford Dictionary of English Etymology，specere 与 spectrum 条"
    },
    {
      "id": "G2",
      "detail": "Lewis & Short 1879, s.v. specto (line 587815)"
    }
  ]
}
