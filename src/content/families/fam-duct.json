        "educate",
        "induce",
        "conducive"
      ]
    },
    {
      "form": "duce",
      "note": "经法语传入的动词不定式词干，词尾 -e 不承载意义",
      "examples": [
        "produce",
        "reduce",
        "introduce"
      ]
    }
  ],
