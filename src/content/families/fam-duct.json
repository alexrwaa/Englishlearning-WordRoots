  "homographTraps": [],
  "teaching": {
    "induction": "给出 produce、reduce、introduce、seduce、conduct 五个词，问：共同的「引」在哪个词里最清楚？前缀把「引」的方向改成了哪边？",
    "transfer": {
      "word": "conducive",
      "question": "拆开并猜义：con- + duc + -ive 为什么会表示「有助于」？",
      "answer": "con- 一起 + duc 引 + -ive …的 → 能把事情一起引向某个结果的，即「有助于…的」。例句：A quiet environment is conducive to deep work."
    }
  },
