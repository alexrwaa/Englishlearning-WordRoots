      "id": "S5",
      "detail": "Oxford Dictionary of English Etymology，struere 与 instrumentum 条"
    },
    {
      "id": "G2",
      "detail": "Lewis & Short 1879, s.v. struo (line 597587)"
    }
  ]
}
