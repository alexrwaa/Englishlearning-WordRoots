{
  "id": "fam-cap",
  "root": {
    "form": "cap",
    "glossEn": "take, seize",
    "glossZh": "拿、抓",
    "origin": "Lat",
    "etymon": "capere",
    "etymonGloss": "to take, seize, grasp"
  },
  "coreIdea": "「拿」：拿到手里是捕获，拿出去是除外，拿住人心是着迷。",
  "members": [
    {
      "w": "capture",
      "relation": "derivative",
      "glossZh": "捕获",
      "layer": [
        "capt",
        "-ure"
      ],
      "note": "capt 是 capere 的分词词干 + -ure 表动作",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "captive",
      "relation": "derivative",
      "glossZh": "俘虏；被俘的",
      "layer": [
        "capt",
        "-ive"
      ],
      "note": "-ive 表人或性质：被抓住的",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "capacity",
      "relation": "derivative",
      "glossZh": "容量；能力",
      "layer": [
        "cap",
        "-ity"
      ],
      "note": "拉丁 capax「能容纳的」+ -ity；-ac- 是 capax 的词干残留",
      "analysis": {
        "kind": "analogical",
        "verified": false,
        "source": "S1",
        "note": "cap + -ity 拼不出 capacity；现代切分是 capac + -ity（cap 的异形）"
      }
    },
    {
      "w": "accept",
      "relation": "derivative",
      "glossZh": "接受",
      "layer": [
        "ac-",
        "cept"
      ],
      "note": "ac- 是 ad- 的同化变体，向 + 拿 → 拿到自己这里",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1",
        "note": "ac- 是 ad- 在 c 前的同化形式"
      }
    },
    {
      "w": "except",
      "relation": "derivative",
      "glossZh": "除外",
      "layer": [
        "ex-",
        "cept"
      ],
      "note": "ex- 向外 + 拿 → 拿到外面去",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "intercept",
      "relation": "derivative",
      "glossZh": "拦截",
      "layer": [
        "inter-",
        "cept"
      ],
      "note": "inter- 在中间 + 拿 → 半路拿走",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "concept",
      "relation": "derivative",
      "glossZh": "概念",
      "layer": [
        "con-",
        "cept"
      ],
      "note": "con- 一起 + 拿 → 把特征拿到一起形成的想法",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "reception",
      "relation": "derivative",
      "glossZh": "接待；接收",
      "layer": [
        "re-",
        "cept",
        "-ion"
      ],
      "note": "re- 回 + 拿 + -ion → 把来者接回来",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "receipt",
      "relation": "derivative",
      "glossZh": "收据",
      "layer": [
        "re-",
        "ceipt"
      ],
      "note": "ceipt 是受法语影响的拼写变体，与 reception 同源",
      "analysis": {
        "kind": "historical",
        "verified": false,
        "source": "S5",
        "note": "ceipt 是受古法语 receite 影响的拼写，不是现代词素；re + ceipt 只是历史形态"
      }
    },
    {
      "w": "deception",
      "relation": "derivative",
      "glossZh": "欺骗",
      "layer": [
        "de-",
        "cept",
        "-ion"
      ],
      "note": "de- 向下、偏离 + 拿 → 把人拿进圈套",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "occupy",
      "relation": "derivative",
      "glossZh": "占据",
      "layer": [
        "oc-",
        "cup",
        "-y"
      ],
      "note": "oc- 是 ob- 的同化变体 + cup 拿 → 压上去拿住",
      "analysis": {
        "kind": "analogical",
        "verified": false,
        "source": "S1",
        "note": "-y 不是后缀；oc + cup + y 是教学拆分"
      }
    },
    {
      "w": "capable",
      "relation": "derivative",
      "glossZh": "有能力的",
      "layer": [
        "cap",
        "-able"
      ],
      "note": "-able 能…的：能拿得住事的",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "caption",
      "relation": "derivative",
      "glossZh": "标题；字幕",
      "layer": [
        "capt",
        "-ion"
      ],
      "note": "拉丁 captio 原义「抓取」，后指「抓住要点的文字」",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "susceptible",
      "relation": "derivative",
      "glossZh": "易受影响的",
      "layer": [
        "sus-",
        "cept",
        "-ible"
      ],
      "note": "sus- 是 sub- 的变体，在下面 + 拿 + -ible → 容易被拿住的",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1",
        "note": "sus- 是 sub- 在 c 前的历史形式，现代只在这个词族里出现"
      }
    }
  ],
  "allomorphs": [
    {
      "form": "capt",
      "note": "拉丁分词词干，出现在 capture / captive 这一类",
      "examples": [
        "capture",
        "captive",
        "caption"
      ]
    },
    {
      "form": "cept",
      "note": "加前缀时的弱化形式，最常见",
      "examples": [
        "accept",
        "except",
        "concept"
      ]
    },
    {
      "form": "cip",
      "note": "元音进一步弱化为 i",
      "examples": [
        "recipient",
        "incipient",
        "participate"
      ]
    },
    {
      "form": "cup",
      "note": "在唇音前圆唇化",
      "examples": [
        "occupy",
        "recuperate"
      ]
    },
    {
      "form": "ceipt",
      "note": "经法语传入的拼写，只有少数词",
      "examples": [
        "receipt"
      ]
    }
  ],
  "derivationChains": [
    {
      "stages": [
        "cap",
        "capture",
        "captive",
        "captivity"
      ],
      "note": "每一级都真实成词；-ive 先造形容词，-ity 再造抽象名词"
    },
    {
      "stages": [
        "cap",
        "accept",
        "acceptance",
        "acceptable"
      ],
      "note": "accept 走 cept，名词 -ance，形容词 -able"
    },
    {
      "stages": [
        "cap",
        "except",
        "exception",
        "exceptional"
      ],
      "note": "exception 的 -ion 前是 t，不是拼写错误"
    },
    {
      "stages": [
        "cap",
        "concept",
        "conception",
        "conceptual"
      ],
      "note": "conceptual 走 -ual，与 concept 的 t 对应"
    }
  ],
  "semanticShifts": [
    {
      "w": "accept",
      "from": "拿到自己这里",
      "to": "接受",
      "why": "收下就是接纳"
    },
    {
      "w": "except",
      "from": "拿出去",
      "to": "除外",
      "why": "把某一项拿到集合之外"
    },
    {
      "w": "capacity",
      "from": "能装下的量",
      "to": "能力",
      "why": "容器能装 → 人能承担"
    },
    {
      "w": "captivate",
      "from": "抓住",
      "to": "使着迷",
      "why": "注意力被抓住"
    }
  ],
  "homographTraps": [
    {
      "form": "capt",
      "other": "captain 的 capt 来自拉丁 caput「头」（capit-），capture / captive 的 capt 来自 capere「拿」",
      "note": "同一拼写 capt 指向两个不同词根；captain 是「头」，capture 是「抓住」，只能靠词义判断"
    },
    {
      "form": "cap",
      "other": "capital、captain、decapitate、per capita 里的 cap 来自拉丁 caput「头」",
      "note": "同形异源：首都/资本/首领都走「头」这条线，与 capere「拿」无关"
    },
    {
      "form": "cap",
      "other": "escape 来自 ex- + cappa「斗篷」（甩掉斗篷逃跑）",
      "note": "不是「拿出去」；把 escape 拆成 ex + cap(e) 会讲错"
    }
  ],
  "teaching": {
    "induction": "给出 capture、accept、except、concept、occupy 五个词，问：共同的「拿」在哪里？前缀把「拿」的方向改成了哪边？词根为什么有时是 cept、cup？",
    "transfer": {
      "word": "capacious",
      "question": "拆开并猜义：cap + -acious 描述的是空间还是时间？",
      "answer": "cap 拿、容纳 + -acious 多…的 → 能装很多的，即「容量大的、宽敞的」。例句：The new library has a capacious reading room."
    }
  },
  "sources": [
