        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "subscribe",
      "relation": "derivative",
      "glossZh": "订阅；赞同",
      "layer": [
        "sub-",
        "scribe"
      ],
      "note": "sub- 在下 + 写 → 在文件下方签名",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "prescribe",
      "relation": "derivative",
      "glossZh": "开处方；规定",
      "layer": [
        "pre-",
        "scribe"
      ],
      "note": "pre- 预先 + 写 → 事先写下该怎么做",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "proscribe",
      "relation": "derivative",
      "glossZh": "禁止",
      "layer": [
        "pro-",
        "scribe"
      ],
      "note": "pro- 公开 + 写 → 把名单公开写出，即宣布为非法",
