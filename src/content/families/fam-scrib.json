  "allomorphs": [
    {
      "form": "script",
      "note": "拉丁过去分词词干，名词与形容词几乎都走这一支",
      "examples": [
        "script",
        "prescription",
        "manuscript"
      ]
    }
  ],
  "derivationChains": [
    {
      "stages": [
        "scrib",
        "describe",
        "description",
        "descriptive"
      ],
      "note": "每一级都真实成词；动词 b → 名词 p 是拉丁音变，不是拼写错误"
    },
    {
      "stages": [
        "scrib",
        "prescribe",
        "prescription",
        "prescriptive"
      ],
      "note": "prescriptive 从「预先写下」转为「规定性的」"
    },
    {
      "stages": [
        "scrib",
        "subscribe",
        "subscription",
        "subscriber"
      ],
      "note": "subscriber 由 subscribe + -er，不经 subscription"
    },
    {
      "stages": [
        "scrib",
        "inscribe",
        "inscription",
        "inscriptional"
      ],
      "note": "inscriptional 较少用，但词典有收"
    }
  ],
  "semanticShifts": [
    {
      "w": "subscribe",
      "from": "在下面签名",
      "to": "订阅；赞同",
      "why": "签名表示同意 → 同意定期付费"
    },
    {
      "w": "prescribe",
      "from": "预先写下",
      "to": "开处方；规定",
      "why": "医生预先写下用药，权威预先写下规则"
    },
    {
      "w": "proscribe",
      "from": "公开写出",
      "to": "禁止",
      "why": "古罗马公开张贴被剥夺保护者的名单"
    },
    {
      "w": "manuscript",
      "from": "手写的",
      "to": "手稿；未刊稿",
      "why": "从书写方式转指载体本身"
    }
  ],
  "homographTraps": [],
  "teaching": {
    "induction": "给出 describe、prescribe、proscribe、subscribe、manuscript 五个词，问：共同的「写」在哪里？pre- 与 pro- 只差一个字母，为什么词义几乎相反？",
    "transfer": {
      "word": "proscribed",
      "question": "拆开并猜义：pro- + scrib + -ed 为什么是「被禁止」而不是「被预先写下」？",
      "answer": "pro- 公开 + scrib 写 + -ed → 被公开写进禁令名单的，即「被禁止的」。注意与 prescribed（被规定的、处方开的）区分。例句：The regulation proscribes the use of the chemical in food packaging."
    }
  },
