        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "subscription",
      "relation": "derivative",
      "glossZh": "订阅（行为）",
      "layer": [
        "sub-",
        "script",
        "-ion"
