{
  "id": "fam-scrib",
  "root": {
    "form": "scrib",
    "glossEn": "write",
    "glossZh": "写",
    "origin": "Lat",
    "etymon": "scribere",
    "etymonGloss": "to write, draw"
  },
  "coreIdea": "「写」：往下写是描述，预先写是规定，公开写是禁止。",
  "members": [
    {
      "w": "describe",
      "relation": "derivative",
      "glossZh": "描述",
      "layer": [
        "de-",
        "scribe"
      ],
      "note": "de- 向下 + 写 → 一笔笔写下来",
      "analysis": {
        "kind": "synchronous",
        "verified": true,
        "source": "S1"
      }
    },
    {
      "w": "inscribe",
      "relation": "derivative",
      "glossZh": "刻写；题献",
      "layer": [
        "in-",
        "scribe"
      ],
      "note": "in- 在内 + 写 → 写进表面里",
