{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WordRoots",
  "version": "0.1.0",
  "identifier": "com.wordroots.learning",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WordRoots · 英语构词学",
        "width": 1320,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/128x128.png"]
  }
}
